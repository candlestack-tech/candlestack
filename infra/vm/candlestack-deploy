#!/usr/bin/env bash
# Forced command for the deploy user's SSH keys (see deploy_authorized_keys).
# Every key has a scope and can only run these commands for its own environments:
#
#   scope    command
#   prod     up prod <version>
#   stage    up stage <version> <backend@digest> <frontend@digest> [<worker@digest>]
#            |   edge   |   agent <image@digest>
#
# "up" and "agent" read a GHCR token from the first line of stdin and use it only for this
# one pull. "up" then reads the environment's secrets as KEY=VALUE lines (only the keys
# read_secrets accepts) and passes them to compose in its environment: no file, never printed.
# Once the containers run, "up" prints "images <backend@digest> <frontend@digest>", followed
# by the worker's image when it started the worker (see runs_worker).
# "up stage" also records its images in the stage record (see stage_images). "up prod" takes
# no images: it runs the ones stage last ran for the commit of the release tag named by
# <version>, as that record has them. Any workflow that may write packages can move a registry
# tag, but only the stage key writes this record, and only main's workflow holds the stage key.
# "up prod" runs compose with infra/env/compose.yaml of the release tag instead of this
# checkout's copy (see release_compose_file); every other "up" uses this checkout's file.
# "edge" updates the checkout to origin/main and reloads the edge Caddy.
# "agent" (re)starts the server agent from infra/agent/compose.yaml of that checkout.
set -euo pipefail
export LC_ALL=C # byte-wise character ranges in the input checks below

scope=${1:?scope}
read -r action env version backend frontend worker _ <<<"${SSH_ORIGINAL_COMMAND:-}"
repo=/opt/candlestack
# Both names of the organization while it is renamed to candlestack-tech: the images built
# before the rename keep the old path (until the old name is dropped here).
image_re='^ghcr\.io/(candlestack-fei-stu|candlestack-tech)/candlestack/[a-z0-9._-]+@sha256:[0-9a-f]{64}$'
compose_file=$repo/infra/env/compose.yaml
# One line "<version> <backend@digest> <frontend@digest> <worker@digest>" per "up stage", in
# the deploy user's home: outside the checkout, which "edge" resets. A line of an "up stage"
# without a worker image (all lines from before the worker) has only the first three fields.
stage_images=${HOME:?}/stage-images

# Temporary directories to remove on exit (DOCKER_CONFIG of pull(), the tag's compose file
# of release_compose_file()).
cleanup_paths=()
cleanup() {
  rm -rf "${cleanup_paths[@]}"
}
trap cleanup EXIT

fail() {
  echo "candlestack-deploy: $*" >&2
  exit 1
}

may_touch() {
  case "$scope" in
    prod) [ "$1" = prod ] ;;
    stage) [ "$1" = stage ] ;;
    *) return 1 ;;
  esac
}

# Redis is a cache: maxmemory, and the container limit a little above it.
redis_memory() {
  case "$1" in
    prod) REDIS_MAXMEMORY=256mb REDIS_MEM_LIMIT=288m ;;
    stage) REDIS_MAXMEMORY=256mb REDIS_MEM_LIMIT=288m ;;
  esac
  export REDIS_MAXMEMORY REDIS_MEM_LIMIT
}

# The worker and its queue (the profile "worker" of compose.yaml) run in both environments:
# "up stage" gets the worker's image in its command, "up prod" takes it from the stage record's
# line of the release's commit like the other two (stage_images_of). A line without one (a
# commit stage ran before the worker) runs the environment without them.
runs_worker() {
  [ "$1" = prod ] || [ "$1" = stage ]
}

# worker_profile <worker@digest or nothing>: compose starts the worker and its queue only with
# an image for the worker.
worker_profile() {
  if [ -n "$1" ]; then
    export COMPOSE_PROFILES=worker WORKER_IMAGE=$1
  else
    unset COMPOSE_PROFILES WORKER_IMAGE
  fi
}

# queue_password <worker@digest or nothing>: the job queue of compose.yaml requires
# QUEUE_PASSWORD. Until the environment has one, its queue runs without a password, as before
# the password: said on every deploy that starts the worker, never failing it.
queue_password() {
  if [ -n "$1" ] && [ -z "${QUEUE_PASSWORD:-}" ]; then
    echo "candlestack-deploy: no QUEUE_PASSWORD: the job queue of $env runs without a password" >&2
  fi
}

# prod and stage share the network "edge" with the edge Caddy and the server agent.
edge_network() {
  case "$1" in
    prod | stage) EDGE_NETWORK=edge ;;
  esac
  export EDGE_NETWORK
}

compose() {
  docker compose -p "$env" -f "$compose_file" "$@"
}

# Every backend build brings a new source layer of about 150 KB, and a dependency layer of
# about 250 MB when uv.lock changes. Images no container uses any more (earlier versions) go,
# so the disk does not fill up; a deploy pulls what it needs again anyway.
prune_images() {
  docker image prune --all --force >/dev/null
}

# prod must start with the deploy files of the tagged release, not whatever main's checkout
# has today (edge resets it to origin/main on every stage deploy). Validates that <version> is
# a release tag reachable from main, fetches it into this checkout (never the working tree,
# so the running script is untouched), points compose_file at that tag's infra/env/compose.yaml
# and sets release_commit to the tag's commit.
release_compose_file() {
  local tag=$1 commit dir
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] ||
    fail "prod version must be a release tag (vX.Y.Z): '$tag'"
  git -C "$repo" fetch --quiet --no-tags origin tag "$tag" ||
    fail "release tag '$tag' not found on origin"
  commit=$(git -C "$repo" rev-parse --verify --quiet "refs/tags/$tag^{commit}") ||
    fail "release tag '$tag' does not point to a commit"
  # The checkout is a shallow clone (see cloud-init.yaml): deepen it so main's real history,
  # not just its latest commit, is available to check the tag against. The clone may track
  # another branch (cloud-init's __GIT_REF__) and "edge" only fetches into FETCH_HEAD, so the
  # refspec names origin/main itself.
  local main_ref=+refs/heads/main:refs/remotes/origin/main
  if [ "$(git -C "$repo" rev-parse --is-shallow-repository)" = true ]; then
    git -C "$repo" fetch --quiet --unshallow origin "$main_ref"
  else
    git -C "$repo" fetch --quiet origin "$main_ref"
  fi
  git -C "$repo" merge-base --is-ancestor "$commit" origin/main ||
    fail "release tag '$tag' is not on main's history"
  dir=$(mktemp -d)
  cleanup_paths+=("$dir")
  git -C "$repo" show "$commit:infra/env/compose.yaml" >"$dir/compose.yaml" ||
    fail "release tag '$tag' has no infra/env/compose.yaml"
  compose_file=$dir/compose.yaml
  release_commit=$commit
}

# stage_images_of <commit>: sets backend, frontend and worker to the images of the last "up
# stage main-<commit>" in the stage record; worker is empty for a line without one.
stage_images_of() {
  local line
  line=$(grep "^main-$1 " "$stage_images" 2>/dev/null | tail -n 1) || true
  [ -n "$line" ] || fail "stage has not run $1: release a commit of main that stage deployed"
  read -r _ backend frontend worker _ <<<"$line"
}

check_image() {
  [[ $1 =~ $image_re ]] || fail "image must be a GHCR digest reference: '$1'"
}

read_token() {
  read -r token || fail "expected a GHCR token on stdin"
}

# The lines after the token, until EOF. Nothing read here is ever printed.
read_secrets() {
  local line key value max
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    [[ $line == *=* ]] || fail "expected KEY=VALUE lines after the token on stdin"
    key=${line%%=*}
    value=${line#*=}
    [[ $key =~ ^(ALPACA_KEY_ID|ALPACA_SECRET_KEY|LOGO_DEV_KEY|SENTRY_DSN|POSTGRES_PASSWORD|OAUTH_(GITHUB|GOOGLE)_CLIENT_(ID|SECRET)|BETA_ALLOWLIST|QUEUE_PASSWORD)$ ]] ||
      fail "only ALPACA_KEY_ID, ALPACA_SECRET_KEY, LOGO_DEV_KEY, SENTRY_DSN, POSTGRES_PASSWORD, the OAUTH_ keys, BETA_ALLOWLIST and QUEUE_PASSWORD may follow the token on stdin"
    # The beta list is comma-separated emails, one per team member and tester: it may be longer.
    max=256
    [ "$key" != BETA_ALLOWLIST ] || max=4096
    [[ $value =~ ^[!-~]{0,$max}$ && $value != *[\"\'\`\\]* ]] ||
      fail "$key must be at most $max printable characters without spaces or quotes"
    # The database URL holds the password as it is: only characters a URL keeps as they are.
    [[ $key != POSTGRES_PASSWORD || $value =~ ^[A-Za-z0-9._~-]{16,256}$ ]] ||
      fail "POSTGRES_PASSWORD must be 16 to 256 letters, digits or the characters . _ ~ -"
    # So does the job queue's URL; empty, the queue runs without a password (see queue_password).
    [[ $key != QUEUE_PASSWORD || $value =~ ^([A-Za-z0-9._~-]{16,256})?$ ]] ||
      fail "QUEUE_PASSWORD must be empty or 16 to 256 letters, digits or the characters . _ ~ -"
    export "$key=$value"
  done
}

# Logs in to GHCR with the token for this command only and pulls the images.
pull() {
  local image
  DOCKER_CONFIG=$(mktemp -d)
  export DOCKER_CONFIG
  cleanup_paths+=("$DOCKER_CONFIG")
  docker login ghcr.io --username deploy --password-stdin <<<"$token" >/dev/null
  for image in "$@"; do
    docker pull --quiet "$image"
  done
}

case "${action:-}" in
  up)
    may_touch "$env" || fail "the $scope key may not deploy '$env'"
    [[ $version =~ ^[A-Za-z0-9._-]{1,64}$ ]] || fail "bad version: '$version'"
    if [ "$env" = prod ]; then
      [ -z "$backend$frontend" ] ||
        fail "up prod takes no images: it runs the ones stage ran for the release's commit"
      release_compose_file "$version"
      stage_images_of "$release_commit"
    fi
    runs_worker "$env" || worker=
    check_image "$backend"
    check_image "$frontend"
    # Without a worker image (a stage workflow run from before the worker) the environment runs
    # without the worker and its queue.
    [ -z "$worker" ] || check_image "$worker"
    read_token
    read_secrets
    pull "$backend" "$frontend" ${worker:+"$worker"}
    redis_memory "$env"
    edge_network "$env"
    worker_profile "$worker"
    queue_password "$worker"
    export ENV_NAME=$env APP_VERSION=$version BACKEND_IMAGE=$backend FRONTEND_IMAGE=$frontend
    compose up --detach --remove-orphans
    # compose leaves the services of a profile it was not given running: the worker of an
    # earlier deploy would go on next to a backend it was not built with.
    if runs_worker "$env" && [ -z "$worker" ]; then
      compose rm --stop --force worker queue
    fi
    if [ "$env" = stage ]; then
      echo "$version $backend $frontend${worker:+ $worker}" >>"$stage_images"
    fi
    echo "images $backend $frontend${worker:+ $worker}"
    prune_images
    ;;
  edge)
    [ "$scope" = stage ] || fail "only the stage key updates the edge"
    git -C "$repo" fetch --quiet --depth 1 origin main
    git -C "$repo" reset --quiet --hard FETCH_HEAD
    docker compose -f "$repo/infra/edge/compose.yaml" up --detach
    docker compose -f "$repo/infra/edge/compose.yaml" exec -T caddy caddy reload --config /etc/caddy/Caddyfile
    ;;
  agent)
    [ "$scope" = stage ] || fail "only the stage key deploys the server agent"
    image=$env # "agent <image@digest>": the image is the first argument
    check_image "$image"
    read_token
    pull "$image"
    IMAGE=$image docker compose -p agent -f "$repo/infra/agent/compose.yaml" up --detach --remove-orphans
    ;;
  *)
    fail "unknown command: '${SSH_ORIGINAL_COMMAND:-}'"
    ;;
esac
