# Settings of the backend (backend/src/candlestack/core/config.py). Copy to .env for
# compose.yaml; every variable is optional and an empty value means the default.
# Never commit .env.

# local, test, stage or prod
APP_ENV=local
# Deployed version (main-<sha>, v0.2.0); set by the deploy
APP_VERSION=dev
# Commit the image was built from; baked in at build time
APP_COMMIT=
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Where the app is reached: the OAuth callbacks, the cookies (Secure and __Host- over https) and
# the same-origin check of sign-out and every other change depend on it. Default by APP_ENV: prod
# https://app.candlestack.tech, stage https://stage.candlestack.tech, local http://localhost:5173 (the
# frontend's dev server), test http://testserver
PUBLIC_URL=

# Cache; compose.yaml points the backend at its own Redis
REDIS_URL=redis://127.0.0.1:6379/0
# Users, sessions and everything users create; compose.yaml points the backend at its own
# Postgres, and its migrate service applies backend/migrations first
DATABASE_URL=postgresql+asyncpg://candlestack:candlestack@127.0.0.1:5432/candlestack

# Directory of the uploaded model files, relative to the working directory; the deployed
# backends keep them in a volume at /data/models
MODEL_STORAGE_DIR=var/models

# The worker that runs the uploaded models (python -m candlestack.worker) and the backend that
# hands it jobs: the job queue, a Redis of its own, with its password where it has one
# (redis://:<password>@host:6379/0; compose.yaml points both at its queue service, whose
# password is candlestack); the directory both share for the jobs' candles and predictions, relative to the
# working directory (a volume at /data/jobs in compose.yaml); and the seconds the worker lets
# one job run before it stops it, at most 3600
JOBS_REDIS_URL=redis://127.0.0.1:6379/1
JOB_FILES_DIR=var/jobs
JOB_TIME_LIMIT=120

# Sign-in with GitHub and Google (OAuth apps whose callback is
# <PUBLIC_URL>/api/v1/auth/github/callback or .../google/callback). A provider without both
# values is off: its sign-in ends on the sign-in page with an error. Locally, the dev sign-in
# (POST /api/v1/auth/dev, local and test only) needs neither
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Comma-separated emails that may sign in with GitHub or Google, any case; empty lets nobody in
BETA_ALLOWLIST=

# Alpaca paper account (https://app.alpaca.markets/paper/dashboard/overview); US stocks
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Assets, calendar and clock
ALPACA_API_URL=https://paper-api.alpaca.markets
# Bars
ALPACA_DATA_URL=https://data.alpaca.markets

# Binance REST and public archives; crypto, no keys needed
BINANCE_API_URL=https://api.binance.com
BINANCE_DATA_URL=https://data.binance.vision

# logo.dev publishable key (https://www.logo.dev/dashboard); instrument icons. Empty: every icon
# is the fallback image
LOGO_DEV_KEY=
LOGO_DEV_URL=https://img.logo.dev

# Most candles in one candle response
CANDLES_MAX=50000
# Candle and instrument-detail requests per minute per client IP (IPv6: per /64); 0 disables
CLIENT_RATE_LIMIT=60
# Our Alpaca requests per minute; default by APP_ENV: prod and stage 180, else 60
ALPACA_RATE_LIMIT=
# Our Binance REST weight per minute
BINANCE_WEIGHT_LIMIT=1000
# Our logo.dev requests per minute (their free plan allows 100 for all environments together);
# default by APP_ENV: prod 50, stage 20, else 20
LOGO_DEV_RATE_LIMIT=

# Refresh the instruments' 24 h stats (volume, change) and mini charts in the background: true
# or false;
# default by APP_ENV: prod and stage true, else false (the list then sorts by symbol)
STATS_REFRESH=

# Sentry project that gets the errors, traces, profiles and logs; empty sends nothing (the deploy
# sets it for prod and stage only)
SENTRY_DSN=
# Share of requests traced in Sentry, 0 to 1; default by APP_ENV: prod 0.2, else 1.0
SENTRY_TRACES_SAMPLE_RATE=

# Frontend dev server (frontend/vite.config.ts), not the backend: where `npm run dev` forwards
# /api/*. Empty is the prod API; http://localhost:8000 is the backend from `docker compose up`.
API_TARGET=
